{
  "name": "godot-mcp",
  "version": "0.2.0-orxtal.1",
  "description": "MCP server for interfacing with Godot game engine. Provides tools for launching the editor, running projects, and capturing debug output.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline"
  ],
  "homepage": "https://github.com/Hushlor/godot-mcp",
  "bugs": {
    "url": "https://github.com/Hushlor/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hushlor/godot-mcp.git"
  },
  "license": "MIT",
  "author": "Solomon Elias <solomon@sippy.ai>",
  "type": "module",
  "bin": {
    "godot-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.18.1",
    "fs-extra": "^11.2.0"
  },
  "overrides": {
    "hono": "4.12.34",
    "@hono/node-server": "2.0.11",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
